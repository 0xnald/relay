RELAY_ENVIRONMENT=development
RELAY_LOG_LEVEL=INFO
RELAY_DATABASE_URL=postgresql+asyncpg://relay:relay_local_only@localhost:5432/relay
RELAY_CORS_ORIGINS=["http://localhost:3000"]
RELAY_TEST_DATABASE_URL=postgresql+asyncpg://relay:relay_local_only@localhost:5432/relay
RELAY_AGENT_MODEL_PROVIDER=bedrock
RELAY_AGENT_MODEL_ID=global.anthropic.claude-sonnet-4-6
RELAY_AWS_REGION=us-east-1
